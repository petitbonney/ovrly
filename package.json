{
  "name": "ovrly",
  "productName": "Ovrly",
  "version": "0.0.0-dev",
  "description": "Node-based automation for live stream interactions",
  "author": "petitbonney",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "node --watch-path=server server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "desktop": "pnpm build && electron .",
    "desktop:build": "pnpm build && pnpm streamdeck:pack && electron-builder --config desktop/electron-builder.yml",
    "test": "node --test test/*.test.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:shots": "pnpm build && docker run --rm --init -v \"$PWD\":/w mcr.microsoft.com/playwright:v1.64.1-noble node /w/docs/screenshots/take.js",
    "streamdeck:pack": "streamdeck pack streamdeck/com.ovrly.deck.sdPlugin -o streamdeck -f --no-update-check",
    "streamdeck:link": "streamdeck link streamdeck/com.ovrly.deck.sdPlugin"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@tabler/icons-react": "^3.49.0",
    "animejs": "4.5.0",
    "cannon-es": "0.20.0",
    "express": "^5.3.0",
    "react": "^19.3.0",
    "sherpa-onnx": "2.0.1",
    "three": "0.186.1",
    "tmi.js": "1.8.5"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/view": "^6.43.15",
    "@elgato/cli": "^1.10.3",
    "@lezer/highlight": "^1.2.5",
    "@mantine/core": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "codemirror": "^6.0.2",
    "electron": "44.9.2",
    "electron-builder": "26.17.0",
    "playwright": "1.64.1",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4",
    "vitepress": "1.6.4"
  }
}
